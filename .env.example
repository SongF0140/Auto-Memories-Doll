# ========================================
# Auto-Memories-Doll 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ========================================

# 运行环境: development | production
NODE_ENV=development

# 模型 API 中转站地址（兼容 OpenAI 格式的 API 均可）
# 示例: https://api.openai.com/v1
MODEL_BASE_URL=http://localhost:8080

# API 密钥（启动前必须填写）
MODEL_API_KEY=

# 记忆数据存储根目录（相对于项目根目录）
# 注意：数据库始终留在此目录，笔记路径可在设置面板中改为其他位置（如 D 盘）
MEMORY_ROOT=./memory-root

# 浏览器历史/书签采集（默认关闭，涉及隐私）
# 设为 true 后，每 30 分钟采集 Chrome/Edge 最近 2 小时浏览记录
# 每 6 小时采集一次书签
BROWSER_COLLECT_ENABLED=false

# 服务端口
PORT=3000
