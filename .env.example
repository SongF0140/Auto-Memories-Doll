# ========================================
# Auto-Memories-Doll 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ========================================

# 运行环境: development | production
NODE_ENV=development

# 模型 API 中转站地址（兼容 OpenAI 格式的 API 均可）
# 示例: https://api.openai.com/v1
MODEL_BASE_URL=http://localhost:8080

# API 密钥（启动前必须填写）
MODEL_API_KEY=

# 记忆数据存储根目录（相对于项目根目录）
MEMORY_ROOT=./memory-root

# 服务端口
PORT=3000
