    "@types/react": "^18.2.40",
    "@types/react-dom": "^18.2.17",
    "ai": "^7.0.34",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.3.2",
    "zod": "^4.4.3"
