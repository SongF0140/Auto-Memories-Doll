  "cards": [
    {
      "dot": "cyan",
      "title": "产品分析",
      "items": [
        "核心不是自动存笔记，而是把知识更新变成可追溯、可拒绝、可人工接管的受控系统。",
        "快轨负责响应，后台加工负责结构化，审计层决定什么能成为长期知识。"
      ]
    },
    {
      "dot": "emerald",
      "title": "优点与对比",
      "items": [
        "Markdown 保持人类可读，SQLite 承担事务和队列，Vector / Graph 作为可重建派生层。",
        "相比直接写文件或单一 workflow，系统具备稳定 ID、串行队列、质量闸门和人工裁决出口。"
      ]
    },
    {
      "dot": "amber",
      "title": "缺陷与改进",
      "items": [
        "Orchestrator 仍聚合质量、审计和派生同步；质量评分与证据覆盖还需要更强的可解释性。",
        "继续拆分 AuditWorker / QualityGate / DerivedSync，补充 review SLA、索引健康度和大库压测指标。"
      ]
    }
  ]
